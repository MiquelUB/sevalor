# SEVALOR SUITE — Variables d'entorn (exemple)
# Copia aquest fitxer a .env i omple els valors reals.
#
# ⚠️ IMPORTANT (AGENTS.md §3.2):
#   En producció, els secrets s'han de gestionar via EasyPanel/Docker Secrets,
#   MAI versionats al repositori. Els valors per defecte són només per a dev.

# ===== Base de Dades PostgreSQL =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sevalor
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ===== Redis (broker + caché) =====
# Deixa REDIS_PASSWORD buit per a dev local; en producció, introdueix contrasenya real.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ===== Cocos: Secret Key (JWT signing) =====
# Genera un valor amb  `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SECRET_KEY=sevalor-dev-secret-key-32-chars-long-abc
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Whisper (IA local) =====
WHISPER_URL=http://localhost:8008

# ===== Bot de Telegram =====
# Token del bot obtingut de @BotFather. Deixa buit fins que es configuri.
TELEGRAM_BOT_TOKEN=

# ===== Dominis (nginx i PWA) =====
# Domini públic on es desplega la suite
DOMAIN=sevalor.app